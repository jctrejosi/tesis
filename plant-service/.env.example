# Conexión a la base de datos compartida del proyecto (TimescaleDB)
# El servicio usa un esquema dedicado (DB_SCHEMA) dentro de la misma base.
DATABASE_URL=postgresql+psycopg://cea_user:cea_password@localhost:5433/cea_db
DB_SCHEMA=plant_service

# Servicio HTTP
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Integración con DeepSeek (obligatoria para las recomendaciones).
# La API key nunca debe ir en el código ni exponerse al navegador.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# Clave compartida para los endpoints del dispositivo (ESP32).
# El ESP debe enviarla en el header `X-API-Key`. Si se deja vacía,
# los endpoints de dispositivo quedan deshabilitados (503).
DEVICE_API_KEY=dev-device-key
